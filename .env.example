# Optional. The app, the agents and the metamorphic harness run fully without any LLM.
# With an LLM configured, the chat ("Ask the Agents") uses it to plan free-form questions and to word the answer
# from the numbers the agents computed (temperature 0). Without one, a rule-based planner and templates are used.
# Copy this file to .env and fill in ONE option. .env is git-ignored.

# Option A: local OpenAI-compatible server (Ollama / LM Studio)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=

# Option B: Azure OpenAI
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
# AZURE_OPENAI_API_VERSION=2024-10-21

# Option C: OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Option D: Google Gemini
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
